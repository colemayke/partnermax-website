# PartnerMax — contact form (Resend) configuration.
# Copy to .env.local and fill in. .env.local is gitignored.

# Required. Create at https://resend.com → API Keys.
RESEND_API_KEY=

# Inbox the channel team receives leads at.
# Defaults to hello@partnermax.ca if unset.
CONTACT_TO_EMAIL=hello@partnermax.ca

# Sender. Resend requires this to be on a domain you have verified
# in the Resend dashboard (resend.com → Domains). The onboarding@resend.dev
# fallback only delivers to the Resend account owner — fine for a first
# test, NOT for production.
CONTACT_FROM_EMAIL="PartnerMax Site <noreply@partnermax.ca>"
